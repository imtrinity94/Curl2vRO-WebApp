{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/server.js" },
    { "src": "/convert", "dest": "/server.js" },
    { "src": "/health", "dest": "/server.js" },
    {
      "src": "/engine/(.*\\.mjs)",
      "headers": { "Content-Type": "text/javascript", "Cache-Control": "public, max-age=3600" },
      "dest": "/public/engine/$1"
    },
    {
      "src": "/engine/(.*\\.wasm)",
      "headers": { "Content-Type": "application/wasm", "Cache-Control": "public, max-age=86400" },
      "dest": "/public/engine/$1"
    },
    { "src": "/", "dest": "/public/index.html" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/public/index.html" }
  ]
}
